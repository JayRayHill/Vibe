---
---

<section class="statement" id="about">
  <div class="container">

    <!-- Three words run across the full width -->
    <div class="statement__identity">
      <p class="statement__word" data-scramble>Think.</p>
      <p class="statement__word" data-scramble>Design.</p>
      <p class="statement__word statement__word--dim" data-scramble>Build.</p>
    </div>

    <!-- Bio below -->
    <div class="statement__bio" data-fade-up>
      <p>
        Three years at Unique Supply have taught me that the gap between
        a good product and a great one lives in the details most people
        scroll past. I design for the ones who notice.
      </p>
      <p>
        My work sits at the intersection of UX thinking and frontend
        craft &mdash; where user needs, business goals, and clean code
        come together into something that just&nbsp;works.
      </p>
      <a href="#contact" class="statement__link">
        Start a project &nbsp;&rarr;
      </a>
    </div>

  </div>
</section>

<style>
  .statement {
    padding:    var(--section-pad) 0;
    border-top: 1px solid var(--border);
  }

  /* ── Words: full-width row ── */
  .statement__identity {
    display:         flex;
    flex-direction:  row;
    justify-content: space-between;
    align-items:     baseline;
    gap:             1rem;
    flex-wrap:       wrap;
    margin-bottom:   clamp(3rem, 6vw, 6rem);
    border-bottom:   1px solid var(--border);
    padding-bottom:  clamp(2rem, 4vw, 4rem);
  }

  .statement__word {
    font-family:    var(--font-display);
    font-size:      clamp(2.5rem, 5.5vw, 5.5rem);
    font-weight:    800;
    letter-spacing: -0.025em;
    line-height:    1.0;
    visibility:     hidden; /* scramble handles reveal — no layout shift */
  }

  .statement__word--dim {
    color: var(--text-muted);
  }

  /* ── Bio: two-column below ── */
  .statement__bio {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(2rem, 5vw, 6rem);
    align-items:           start;
  }

  .statement__bio p {
    font-size:   1rem;
    color:       var(--text-soft);
    line-height: 1.8;
  }

  .statement__link {
    display:        inline-block;
    grid-column:    2;
    font-size:      0.875rem;
    letter-spacing: 0.04em;
    color:          var(--text-muted);
    transition:     color 0.2s, border-color 0.2s;
    border-bottom:  1px solid var(--border);
    padding-bottom: 0.25rem;
    align-self:     end;
    margin-top:     1.5rem;
  }

  .statement__link:hover {
    color:        var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 768px) {
    .statement__identity {
      flex-direction: column;
      gap:            0.25rem;
    }

    .statement__bio {
      grid-template-columns: 1fr;
    }

    .statement__link { grid-column: 1; }
  }
</style>
