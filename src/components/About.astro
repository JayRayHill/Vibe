---
const capabilities = [
  'UX Research & Strategy',
  'UI / Visual Design',
  'Interaction Design',
  'Design Systems',
  'Prototyping & Testing',
  'Web Development',
];
---

<section class="about" id="about">
  <div class="container">
    <div class="about__inner">

      <!-- Left: sticky heading -->
      <div class="about__left" data-scroll-reveal>
        <span class="section-label">About Me</span>
        <h2 class="section-title about__heading">
          Design with<br /><em>intention.</em>
        </h2>
      </div>

      <!-- Right: scrollable content -->
      <div class="about__right" data-scroll-reveal>
        <p class="about__bio">
          I&rsquo;m a web designer and UX specialist with a passion for creating
          digital experiences that are both beautiful and functional. I believe
          the best design is invisible &mdash; it guides users effortlessly toward
          their goals without getting in the way.
        </p>
        <p class="about__bio">
          My approach is rooted in research and iteration. I combine strategic
          thinking with a meticulous eye for detail, making sure every element
          on screen earns its place and every interaction feels considered.
        </p>

        <div class="about__cap">
          <h3 class="about__cap-label">Capabilities</h3>
          <ul class="about__cap-list">
            {capabilities.map((cap) => <li>{cap}</li>)}
          </ul>
        </div>

        <a href="mailto:hello@jayrayhill.com" class="btn btn--ghost about__contact magnetic">
          hello@jayrayhill.com &nbsp;&rarr;
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  .about {
    padding:    var(--section-pad) 0;
    border-top: 1px solid var(--border);
  }

  .about__inner {
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   clamp(3rem, 8vw, 10rem);
    align-items:           start;
  }

  /* Sticky left heading */
  .about__heading {
    position:   sticky;
    top:        calc(var(--nav-h) + 2.5rem);
    margin-bottom: 0;
  }

  /* Right column */
  .about__bio {
    font-size:     1.0625rem;
    line-height:   1.8;
    color:         var(--text-muted);
    margin-bottom: 1.5rem;
  }

  .about__bio + .about__bio {
    margin-bottom: 2.5rem;
  }

  /* Capabilities */
  .about__cap {
    margin-bottom: 2.5rem;
  }

  .about__cap-label {
    font-size:      0.65rem;
    font-weight:    500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color:          var(--accent);
    margin-bottom:  1rem;
  }

  .about__cap-list {
    list-style:            none;
    display:               grid;
    grid-template-columns: 1fr 1fr;
    gap:                   0;
  }

  .about__cap-list li {
    font-size:     0.875rem;
    color:         var(--text-muted);
    padding:       0.6rem 0;
    border-bottom: 1px solid var(--border);
    transition:    color 0.2s, padding-left 0.25s ease;
  }

  .about__cap-list li:hover {
    color:        var(--text);
    padding-left: 0.6rem;
  }

  .about__contact {
    margin-top: 0.5rem;
  }

  /* Mobile */
  @media (max-width: 768px) {
    .about__inner {
      grid-template-columns: 1fr;
      gap:                   3rem;
    }

    .about__heading {
      position: static;
    }
  }
</style>
