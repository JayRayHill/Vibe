---
---

<section class="hero" id="hero">

  <!-- Background decoration -->
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__grid"></div>
    <div class="hero__glow"></div>
  </div>

  <div class="container hero__inner">
    <div class="hero__content">
      <p class="hero__label">Web Design &amp; UX</p>

      <h1 class="hero__heading">
        <span class="hero__line">Crafting digital</span>
        <span class="hero__line">experiences that</span>
        <span class="hero__line hero__line--accent">feel inevitable.</span>
      </h1>

      <p class="hero__sub">
        I design minimal, interactive interfaces that put function first
        and leave a lasting impression.
      </p>

      <div class="hero__actions">
        <a href="#work"  class="btn btn--primary magnetic">View Work</a>
        <a href="#about" class="btn btn--ghost  magnetic">About Me</a>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="hero__scroll" aria-hidden="true">
      <span>Scroll</span>
      <div class="hero__scroll-track"><div class="hero__scroll-bar"></div></div>
    </div>
  </div>

</section>

<style>
  .hero {
    position:    relative;
    min-height:  100svh;
    display:     flex;
    align-items: center;
    overflow:    hidden;
    padding-top: var(--nav-h);
  }

  .hero__inner {
    position:       relative;
    z-index:        2;
    padding-top:    clamp(60px, 8vw, 120px);
    padding-bottom: clamp(100px, 14vw, 180px);
    width:          100%;
  }

  .hero__content {
    max-width: 960px;
  }

  /* Label */
  .hero__label {
    font-size:      0.7rem;
    font-weight:    500;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color:          var(--accent);
    margin-bottom:  1.75rem;
    opacity:        0;
    transform:      translateY(12px);
  }

  /* Heading */
  .hero__heading {
    font-family:    var(--font-display);
    font-size:      clamp(3.2rem, 7.5vw, 7.5rem);
    font-weight:    800;
    line-height:    1.0;
    letter-spacing: -0.025em;
    margin-bottom:  2rem;
  }

  .hero__line {
    display:   block;
    opacity:   0;
    transform: translateY(44px);
  }

  .hero__line--accent {
    color:      var(--accent);
    font-style: italic;
  }

  /* Subtext */
  .hero__sub {
    font-size:     clamp(1rem, 1.4vw, 1.15rem);
    color:         var(--text-muted);
    line-height:   1.75;
    max-width:     520px;
    margin-bottom: 3rem;
    opacity:       0;
  }

  /* CTAs */
  .hero__actions {
    display:     flex;
    gap:         1rem;
    align-items: center;
    flex-wrap:   wrap;
    opacity:     0;
  }

  /* Scroll indicator */
  .hero__scroll {
    position:       absolute;
    bottom:         3.5rem;
    left:           var(--gutter);
    display:        flex;
    align-items:    center;
    gap:            0.875rem;
    font-size:      0.65rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--text-muted);
    opacity:        0;
  }

  .hero__scroll-track {
    width:    48px;
    height:   1px;
    background: var(--border);
    overflow: hidden;
    position: relative;
  }

  .hero__scroll-bar {
    position:   absolute;
    top:        0;
    left:       -100%;
    width:      100%;
    height:     100%;
    background: var(--accent);
    animation:  scrollPulse 2.2s ease-in-out infinite;
  }

  @keyframes scrollPulse {
    0%   { left: -100%; }
    50%  { left: 0%;    }
    100% { left: 100%;  }
  }

  /* ── Background elements ── */
  .hero__bg {
    position: absolute;
    inset:    0;
    z-index:  1;
    overflow: hidden;
  }

  .hero__grid {
    position:         absolute;
    inset:            0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
    background-size:  80px 80px;
    mask-image:       radial-gradient(ellipse 80% 70% at 50% 40%, black 10%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 40%, black 10%, transparent 100%);
  }

  .hero__glow {
    position:   absolute;
    top:        10%;
    right:      5%;
    width:      700px;
    height:     700px;
    background: radial-gradient(circle, rgba(57, 255, 20, 0.04) 0%, transparent 65%);
    pointer-events: none;
  }
</style>

<script>
  import gsap from 'gsap';

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.15 });

  tl.to('.hero__label',   { opacity: 1, y: 0, duration: 0.7 })
    .to('.hero__line',    { opacity: 1, y: 0, duration: 0.75, stagger: 0.11 }, '-=0.35')
    .to('.hero__sub',     { opacity: 1,        duration: 0.7  }, '-=0.4')
    .to('.hero__actions', { opacity: 1,        duration: 0.6  }, '-=0.5')
    .to('.hero__scroll',  { opacity: 1,        duration: 0.6  }, '-=0.4');
</script>
