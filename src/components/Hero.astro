---
---

<section class="hero" id="top">
  <div class="container hero__inner">

    <div class="hero__top">
      <p class="hero__avail">
        <span class="hero__dot" aria-hidden="true"></span>
        Currently at Unique Supply &nbsp;·&nbsp; Available for freelance
      </p>
    </div>

    <div class="hero__center">
      <h1 class="hero__name">
        <span class="hero__name-line">JARON</span>
        <span class="hero__name-line">HILL</span>
      </h1>

      <p class="hero__tagline">
        Building systems that work<br />and look beautiful.
      </p>

      <div class="hero__actions">
        <a href="#contact" class="btn btn--primary magnetic">Contact</a>
        <a href="#work" class="btn btn--outline magnetic">View Work</a>
      </div>
    </div>

    <div class="hero__bottom">
      <p class="hero__role">Web Design &amp; UX</p>
      <div class="hero__scroll-hint" aria-hidden="true">
        <span>Scroll</span>
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
          <path d="M8 3v10M4 9l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </div>
    </div>

  </div>
</section>

<style>
  .hero {
    min-height:    100svh;
    display:       flex;
    align-items:   stretch;
    padding-top:   var(--nav-h);
    border-bottom: 1px solid var(--border);
  }

  .hero__inner {
    display:         flex;
    flex-direction:  column;
    justify-content: space-between;
    width:           100%;
    padding-top:     clamp(2rem, 4vw, 4rem);
    padding-bottom:  clamp(2rem, 4vw, 4rem);
  }

  /* ── Top bar ── */
  .hero__top {
    display:     flex;
    align-items: center;
    /* availability note sits top-right */
    justify-content: flex-end;
  }

  .hero__avail {
    display:        flex;
    align-items:    center;
    gap:            0.6rem;
    font-size:      0.75rem;
    color:          var(--text-muted);
    letter-spacing: 0.04em;
    opacity:        0;
    transform:      translateY(-8px);
  }

  .hero__dot {
    width:         7px;
    height:        7px;
    border-radius: 50%;
    background:    var(--accent);
    flex-shrink:   0;
    box-shadow:    0 0 8px rgba(57, 255, 20, 0.6);
    animation:     pulse 2.4s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1;   box-shadow: 0 0 8px  rgba(57,255,20,0.6); }
    50%       { opacity: 0.6; box-shadow: 0 0 16px rgba(57,255,20,0.3); }
  }

  /* ── Center block — LEFT aligned, contained size ── */
  .hero__center {
    display:        flex;
    flex-direction: column;
    align-items:    flex-start;   /* left-align everything */
    gap:            clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__name {
    font-family:    var(--font-display);
    font-size:      clamp(3.5rem, 9vw, 9rem); /* much smaller than before */
    font-weight:    800;
    line-height:    0.92;
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .hero__name-line {
    display:   block;
    opacity:   0;
    transform: translateY(50px);
  }

  .hero__tagline {
    font-size:   clamp(1rem, 1.6vw, 1.3rem);
    color:       var(--text-soft);
    line-height: 1.6;
    font-weight: 300;
    opacity:     0;
    max-width:   420px;
  }

  .hero__actions {
    display:     flex;
    gap:         0.875rem;
    align-items: center;
    flex-wrap:   wrap;
    opacity:     0;
    transform:   translateY(30px);
  }

  /* ── Bottom bar ── */
  .hero__bottom {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
  }

  .hero__role {
    font-size:      0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color:          var(--text-muted);
    opacity:        0;
    transform:      translateY(8px);
  }

  .hero__scroll-hint {
    display:        flex;
    align-items:    center;
    gap:            0.5rem;
    font-size:      0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color:          var(--text-muted);
    opacity:        0;
    animation:      bob 2.2s ease-in-out infinite;
  }

  @keyframes bob {
    0%, 100% { transform: translateY(0);  }
    50%       { transform: translateY(4px); }
  }

  @media (max-width: 600px) {
    .hero__bottom         { flex-direction: column; gap: 1rem; align-items: flex-start; }
    .hero__scroll-hint    { display: none; }
  }
</style>

<script>
  import gsap from 'gsap';

  const tl = gsap.timeline({ defaults: { ease: 'power3.out' }, delay: 0.9 });

  tl.to('.hero__avail',       { opacity: 1, y: 0, duration: 0.6 })
    .to('.hero__name-line',   { opacity: 1, y: 0, duration: 0.85, stagger: 0.1 }, '-=0.2')
    .to('.hero__tagline',     { opacity: 1,        duration: 0.7 }, '-=0.4')
    .to('.hero__actions',     { opacity: 1,        duration: 0.6 }, '-=0.4')
    .to('.hero__role',        { opacity: 1, y: 0, duration: 0.6 }, '-=0.35')
    .to('.hero__scroll-hint', { opacity: 1,        duration: 0.6 }, '-=0.5');
</script>
