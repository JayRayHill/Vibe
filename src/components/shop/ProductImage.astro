---
/**
 * Product imagery.
 *
 * Two modes, chosen per product:
 *
 *   1. REAL PHOTO — set `image` on the product in src/data/products.js to a
 *      path under /public (e.g. '/products/range.webp'). It is used as-is.
 *   2. VECTOR RENDERING — the fallback. Photography of the real units does not
 *      exist yet, and every stock-photo and supplier host is blocked by this
 *      environment's network egress proxy, so each device is drawn instead.
 *      These scale losslessly, weigh nothing, and theme to the accent hue.
 *
 * Dropping a file into public/products/ and adding one `image:` line switches
 * a product from drawing to photograph. Nothing else changes.
 */
interface Props {
  handle: string;
  hue:    number;
  alt:    string;
  image?: string | null;
  eager?: boolean;
}

const { handle, hue, alt, image = null, eager = false } = Astro.props;

const uid  = `pi-${handle}`;
const lit  = `hsl(${hue}, 90%, 60%)`;
const soft = `hsla(${hue}, 90%, 60%, 0.55)`;
const haze = `hsla(${hue}, 92%, 55%, 0.26)`;
---
{image ? (
  <img
    class="k-img k-img--photo"
    src={image}
    alt={alt}
    loading={eager ? 'eager' : 'lazy'}
    decoding="async"
    width="1200"
    height="960"
  />
) : (
<svg
  class="k-img"
  viewBox="0 0 400 320"
  role="img"
  aria-label={alt}
  preserveAspectRatio="xMidYMid meet"
>
  <defs>
    <radialGradient id={`${uid}-amb`} cx="50%" cy="46%" r="60%">
      <stop offset="0%"   stop-color={haze} />
      <stop offset="100%" stop-color="transparent" />
    </radialGradient>

    <!-- Body shell: top-lit dark plastic -->
    <linearGradient id={`${uid}-shell`} x1="0" y1="0" x2="0.35" y2="1">
      <stop offset="0%"   stop-color="#3a3a42" />
      <stop offset="45%"  stop-color="#26262c" />
      <stop offset="100%" stop-color="#131317" />
    </linearGradient>

    <!-- Secondary shell, one step darker -->
    <linearGradient id={`${uid}-shell2`} x1="0" y1="0" x2="0.3" y2="1">
      <stop offset="0%"   stop-color="#2c2c33" />
      <stop offset="100%" stop-color="#101014" />
    </linearGradient>

    <!-- Fabric / textile -->
    <linearGradient id={`${uid}-fab`} x1="0" y1="0" x2="0.5" y2="1">
      <stop offset="0%"   stop-color="#33333b" />
      <stop offset="100%" stop-color="#1a1a1f" />
    </linearGradient>

    <!-- Emissive face -->
    <linearGradient id={`${uid}-glow`} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%"   stop-color={soft} />
      <stop offset="100%" stop-color={`hsla(${hue}, 90%, 45%, 0.25)`} />
    </linearGradient>

    <filter id={`${uid}-blur`} x="-50%" y="-50%" width="200%" height="200%">
      <feGaussianBlur stdDeviation="9" />
    </filter>
  </defs>

  <rect width="400" height="320" fill="#17171a" />
  <rect width="400" height="320" fill={`url(#${uid}-amb)`} />

  <!-- Contact shadow, shared by every device -->
  <ellipse cx="200" cy="288" rx="112" ry="12" fill="#000" opacity="0.5" filter={`url(#${uid}-blur)`} />

  {/* ───────────── RANGE — percussion massage gun ───────────── */}
  {handle === 'range-percussion-gun' && (
    <g>
      <circle cx="118" cy="132" r="30" fill={`url(#${uid}-shell2)`} stroke="#45454f" stroke-width="1" />
      <circle cx="112" cy="125" r="11" fill="#4e4e59" opacity="0.5" />
      <rect x="146" y="121" width="26" height="22" rx="7" fill="#3c3c45" />
      <rect x="168" y="94" width="116" height="70" rx="26" fill={`url(#${uid}-shell)`} stroke="#4a4a55" stroke-width="1" />
      <rect x="196" y="110" width="58" height="26" rx="5" fill={`url(#${uid}-glow)`} stroke={soft} stroke-width="0.8" />
      <text x="225" y="128" text-anchor="middle" font-family="monospace" font-size="13" fill={lit}>04</text>
      <path d="M206 164 L246 164 L238 250 Q236 262 224 262 L212 262 Q200 262 198 250 Z" fill={`url(#${uid}-shell)`} stroke="#42424c" stroke-width="1" />
      <rect x="203" y="182" width="36" height="4" rx="2" fill="#0d0d10" opacity="0.85" />
      <rect x="203" y="192" width="36" height="4" rx="2" fill="#0d0d10" opacity="0.85" />
      <rect x="203" y="202" width="36" height="4" rx="2" fill="#0d0d10" opacity="0.85" />
      <rect x="201" y="255" width="38" height="12" rx="5" fill="#26262c" />
      <circle cx="221" cy="238" r="5" fill={lit} opacity="0.9" />
      <path d="M180 100 Q226 92 272 100" stroke="#5c5c68" stroke-width="1.5" fill="none" opacity="0.55" />
    </g>
  )}

  {/* ───────────── FIELD — red light therapy panel ───────────── */}
  {handle === 'field-red-light-panel' && (
    <g>
      <path d="M158 268 L200 214 L242 268" stroke="#3a3a44" stroke-width="7" fill="none" stroke-linecap="round" />
      <rect x="194" y="186" width="12" height="40" rx="4" fill="#33333c" />
      <rect x="96" y="48" width="208" height="146" rx="9" fill={`url(#${uid}-shell)`} stroke="#4a4a55" stroke-width="1.2" />
      <rect x="107" y="59" width="186" height="124" rx="5" fill="#0c0c0f" />
      <rect x="107" y="59" width="186" height="124" rx="5" fill={`url(#${uid}-glow)`} opacity="0.75" />
      {[0, 1, 2, 3, 4].map((r) =>
        [0, 1, 2, 3, 4, 5, 6, 7, 8].map((c) => (
          <circle
            cx={119 + c * 20.5} cy={72 + r * 25} r="6.4"
            fill={lit} opacity={(r + c) % 2 === 0 ? 0.95 : 0.42}
          />
        ))
      )}
      <rect x="107" y="59" width="186" height="124" rx="5" fill="none" stroke={soft} stroke-width="0.9" />
      <circle cx="286" cy="188" r="3.4" fill={lit} />
    </g>
  )}

  {/* ───────────── VEIL — LED face mask ───────────── */}
  {handle === 'veil-led-face-mask' && (
    <g>
      {/* Head strap, drawn behind — reads as a wearable, not a face */}
      <path d="M132 96 Q96 108 92 152 Q90 178 104 192" stroke="#3c3c45" stroke-width="11" fill="none" stroke-linecap="round" />
      <path d="M268 96 Q304 108 308 152 Q310 178 296 192" stroke="#3c3c45" stroke-width="11" fill="none" stroke-linecap="round" />

      {/* Soft silicone shell — wide and rounded, closer to a visor than a face */}
      <path d="M200 74 Q278 74 288 130 Q296 186 244 222 Q200 250 156 222 Q104 186 112 130 Q122 74 200 74 Z"
            fill={`url(#${uid}-shell2)`} stroke="#50505b" stroke-width="1.3" />
      <path d="M200 84 Q270 84 279 132 Q286 182 240 213 Q200 238 160 213 Q114 182 121 132 Q130 84 200 84 Z"
            fill={`url(#${uid}-glow)`} opacity="0.8" />

      {/* Eye apertures — shallow, rimmed and lit, not hollow voids */}
      {[[162,140],[238,140]].map(([x, y]) => (
        <g>
          <rect x={x - 27} y={y - 12} width="54" height="24" rx="12" fill="#1c1c22" stroke="#5a5a66" stroke-width="1.2" />
          <rect x={x - 23} y={y - 8} width="46" height="16" rx="8" fill={lit} opacity="0.18" />
        </g>
      ))}

      {/* Breathing slot — a straight vent, deliberately not a mouth curve */}
      <rect x="176" y="196" width="48" height="9" rx="4.5" fill="#1c1c22" stroke="#5a5a66" stroke-width="1" />

      {/* LED array — an even grid, so it reads as an emitter panel */}
      {[[200,100],[168,106],[232,106],[140,124],[260,124],[136,162],[264,162],[200,120],
        [150,186],[250,186],[176,166],[224,166],[200,164],[200,224],[178,214],[222,214]].map(([x, y]) => (
        <circle cx={x} cy={y} r="4.8" fill={lit} opacity="0.9" />
      ))}

      {/* Controller clipped to the strap */}
      <rect x="286" y="188" width="30" height="44" rx="8" fill={`url(#${uid}-shell)`} stroke="#54545f" stroke-width="1" />
      <circle cx="301" cy="203" r="5" fill={lit} opacity="0.95" />
      <rect x="293" y="215" width="16" height="3" rx="1.5" fill="#5a5a66" />
      <rect x="293" y="222" width="16" height="3" rx="1.5" fill="#5a5a66" />
    </g>
  )}

  {/* ───────────── TIDE — compression recovery boots ───────────── */}
  {handle === 'tide-compression-boots' && (
    <g>
      {[128, 228].map((x, i) => (
        <g>
          <path d={`M${x} 62 L${x + 46} 62 Q${x + 52} 62 ${x + 52} 72 L${x + 50} 246 Q${x + 50} 258 ${x + 38} 258 L${x + 6} 258 Q${x - 6} 258 ${x - 6} 246 L${x - 4} 72 Q${x - 4} 62 ${x} 62 Z`}
                fill={`url(#${uid}-fab)`} stroke="#4a4a55" stroke-width="1.2" />
          {[0, 1, 2, 3].map((k) => (
            <line
              x1={x - 5} y1={104 + k * 46} x2={x + 51} y2={104 + k * 46}
              stroke="#0e0e12" stroke-width="2.5" opacity="0.9"
            />
          ))}
          {[0, 1, 2, 3].map((k) => (
            <circle cx={x + 23} cy={84 + k * 46} r="3.6" fill={lit} opacity={0.85 - k * 0.16} />
          ))}
          <line x1={x + 23} y1="66" x2={x + 23} y2="254" stroke={soft} stroke-width="1.1" stroke-dasharray="4 5" />
          <rect x={x + 14} y="54" width="18" height="12" rx="4" fill="#3c3c45" stroke="#54545f" stroke-width="0.8" />
          <path d={`M${x + 23} 54 q ${i === 0 ? 24 : -24} -22 ${i === 0 ? 44 : -44} -8`} stroke="#3a3a44" stroke-width="3.5" fill="none" stroke-linecap="round" />
        </g>
      ))}
      <rect x="168" y="20" width="64" height="30" rx="7" fill={`url(#${uid}-shell)`} stroke="#4d4d58" stroke-width="1" />
      <rect x="178" y="28" width="44" height="14" rx="3" fill={`url(#${uid}-glow)`} stroke={soft} stroke-width="0.7" />
    </g>
  )}

  {/* ───────────── EMBER — infrared sauna blanket ───────────── */}
  {handle === 'ember-sauna-blanket' && (
    <g>
      <path d="M74 96 L326 96 Q338 96 336 110 L318 244 Q316 258 302 258 L98 258 Q84 258 82 244 L64 110 Q62 96 74 96 Z"
            fill={`url(#${uid}-fab)`} stroke="#4a4a55" stroke-width="1.2" />
      {[0, 1, 2, 3, 4, 5, 6, 7].map((i) => (
        <line
          x1={78 + i * 2} y1={116 + i * 17} x2={322 - i * 2} y2={116 + i * 17}
          stroke="#0e0e12" stroke-width="2" opacity="0.75"
        />
      ))}
      <path d="M200 96 L200 258" stroke={soft} stroke-width="2" stroke-dasharray="6 6" />
      <path d="M200 96 L200 258" stroke={lit} stroke-width="0.8" opacity="0.5" />
      {[0, 1, 2].map((r) =>
        [0, 1, 2].map((c) => (
          <circle cx={128 + c * 72} cy={140 + r * 44} r="4.6" fill={lit} opacity={0.75 - r * 0.14} />
        ))
      )}
      <rect x="292" y="34" width="62" height="44" rx="8" fill={`url(#${uid}-shell)`} stroke="#4d4d58" stroke-width="1" />
      <rect x="302" y="44" width="42" height="18" rx="4" fill={`url(#${uid}-glow)`} stroke={soft} stroke-width="0.7" />
      <text x="323" y="58" text-anchor="middle" font-family="monospace" font-size="11" fill={lit}>75°</text>
      <path d="M300 78 Q276 92 262 96" stroke="#3a3a44" stroke-width="3.5" fill="none" stroke-linecap="round" />
    </g>
  )}

  {/* ───────────── STILL — cold plunge tub ───────────── */}
  {handle === 'still-cold-plunge' && (
    <g>
      <path d="M112 250 L128 132 M288 250 L272 132" stroke="#33333c" stroke-width="7" stroke-linecap="round" />
      <path d="M104 246 L296 246" stroke="#33333c" stroke-width="7" stroke-linecap="round" />
      <path d="M124 122 L276 122 L262 240 Q260 252 246 252 L154 252 Q140 252 138 240 Z"
            fill={`url(#${uid}-shell)`} stroke="#4a4a55" stroke-width="1.2" />
      <ellipse cx="200" cy="122" rx="76" ry="21" fill="#101015" stroke="#50505b" stroke-width="1.4" />
      <ellipse cx="200" cy="126" rx="66" ry="17" fill={`url(#${uid}-glow)`} opacity="0.85" />
      {[[176,120,9],[214,124,11],[196,131,7],[228,118,7],[164,128,6]].map(([x, y, s]) => (
        <rect x={x} y={y} width={s} height={s * 0.72} rx="2" fill="#dff3fb" opacity="0.82" />
      ))}
      <path d="M138 160 L262 160" stroke="#0e0e12" stroke-width="2" opacity="0.6" />
      <path d="M142 196 L258 196" stroke="#0e0e12" stroke-width="2" opacity="0.6" />
      <circle cx="268" cy="212" r="7" fill="#2a2a32" stroke="#4d4d58" stroke-width="1" />
      <ellipse cx="200" cy="122" rx="76" ry="21" fill="none" stroke={soft} stroke-width="0.9" />
    </g>
  )}

  {/* ───────────── GRID — acupressure mat & pillow ───────────── */}
  {handle === 'grid-acupressure-mat' && (
    <g>
      <path d="M92 132 L272 118 L288 216 L108 236 Z" fill={`url(#${uid}-fab)`} stroke="#4a4a55" stroke-width="1.2" />
      {[0, 1, 2, 3, 4].map((r) =>
        [0, 1, 2, 3, 4, 5, 6, 7].map((c) => (
          <circle
            cx={112 + c * 22 + r * 2.4}
            cy={146 + r * 19 - c * 1.1}
            r="4.4"
            fill={lit}
            opacity={0.34 + (((r * 5 + c * 3) % 4) * 0.17)}
          />
        ))
      )}
      <path d="M272 118 Q312 122 314 164 Q316 208 288 216 Q306 196 302 166 Q298 132 272 132 Z"
            fill={`url(#${uid}-shell2)`} stroke="#50505b" stroke-width="1.1" />
      <ellipse cx="302" cy="167" rx="13" ry="24" fill="#1c1c22" stroke="#4a4a55" stroke-width="1" />
      <g transform="translate(78 236)">
        <path d="M0 0 Q0 -26 26 -26 L74 -30 Q100 -30 100 -6 Q100 16 74 16 L26 20 Q0 20 0 0 Z"
              fill={`url(#${uid}-fab)`} stroke="#4a4a55" stroke-width="1.1" />
        {[0, 1, 2, 3].map((c) => (
          <circle cx={24 + c * 20} cy={-6 - c * 1.4} r="3.6" fill={lit} opacity="0.55" />
        ))}
      </g>
    </g>
  )}

  {/* ───────────── COLLAR — heated neck & shoulder massager ───────────── */}
  {handle === 'collar-neck-massager' && (
    <g>
      <path d="M200 66 Q120 66 104 136 Q92 190 118 206 L142 154 Q158 106 200 106 Q242 106 258 154 L282 206 Q308 190 296 136 Q280 66 200 66 Z"
            fill={`url(#${uid}-fab)`} stroke="#4d4d58" stroke-width="1.2" />
      <path d="M118 206 L112 262 Q110 274 124 274 L150 274 Q162 274 160 262 L150 192"
            fill={`url(#${uid}-shell2)`} stroke="#4a4a55" stroke-width="1.1" />
      <path d="M282 206 L288 262 Q290 274 276 274 L250 274 Q238 274 240 262 L250 192"
            fill={`url(#${uid}-shell2)`} stroke="#4a4a55" stroke-width="1.1" />
      {[[150,128],[178,112],[222,112],[250,128],[136,166],[264,166],[160,142],[240,142]].map(([x, y]) => (
        <g>
          <circle cx={x} cy={y} r="10" fill="#22222a" stroke="#55555f" stroke-width="1" />
          <circle cx={x} cy={y} r="4.6" fill={lit} opacity="0.9" />
        </g>
      ))}
      <path d="M200 78 Q136 80 122 140" stroke={soft} stroke-width="1.2" fill="none" stroke-dasharray="5 5" />
      <path d="M200 78 Q264 80 278 140" stroke={soft} stroke-width="1.2" fill="none" stroke-dasharray="5 5" />
      <rect x="182" y="70" width="36" height="20" rx="6" fill={`url(#${uid}-shell)`} stroke="#54545f" stroke-width="0.9" />
      <circle cx="200" cy="80" r="5" fill={lit} />
    </g>
  )}
</svg>
)}

<style>
  .k-img { width: 100%; height: 100%; display: block; }

  /* Photographs fill the frame; drawings are already composed to it. */
  .k-img--photo { object-fit: cover; }
</style>
