---
import Layout    from '../layouts/Layout.astro';
import Cursor    from '../components/Cursor.astro';
import Nav       from '../components/Nav.astro';
import Hero      from '../components/Hero.astro';
import Services  from '../components/Services.astro';
import Work      from '../components/Work.astro';
import Skills    from '../components/Skills.astro';
import Statement from '../components/Statement.astro';
import Contact   from '../components/Contact.astro';
---

<Layout
  title="Jaron Hill — Web Designer & UX"
  description="Portfolio of Jaron Hill — web designer and UX at Unique Supply, building systems that work and look beautiful."
>
  <!-- White intro overlay that slides away on load -->
  <div class="intro" id="intro" aria-hidden="true">
    <span class="intro__name">JARON HILL</span>
  </div>

  <Cursor />
  <Nav />

  <main id="main">
    <Hero />
    <Services />
    <Work />
    <Skills />
    <Statement />
    <Contact />
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <div class="footer__left">
        <span class="footer__name">Jaron Hill</span>
        <span class="footer__caption">Web Design &amp; UX</span>
      </div>
      <nav class="footer__nav" aria-label="Footer navigation">
        <a href="#work">Work</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>
      <div class="footer__social">
        <a href="#" class="footer__social-link">LinkedIn</a>
        <a href="#" class="footer__social-link">GitHub</a>
        <a href="#" class="footer__social-link">Dribbble</a>
      </div>
    </div>
    <div class="container footer__base">
      <span>&copy; {new Date().getFullYear()} Jaron Hill. All rights reserved.</span>
      <span class="footer__credit">Built with Astro &amp; GSAP</span>
    </div>
  </footer>
</Layout>

<style>
  /* ── Page intro overlay ── */
  .intro {
    position:        fixed;
    inset:           0;
    z-index:         9999;
    background:      #ffffff;
    display:         flex;
    align-items:     center;
    justify-content: center;
    pointer-events:  none;
  }

  .intro__name {
    font-family:    var(--font-display);
    font-size:      clamp(2rem, 6vw, 5rem);
    font-weight:    800;
    letter-spacing: -0.025em;
    color:          #080808;
    opacity:        0;
  }

  /* ── Footer ── */
  .footer {
    border-top: 1px solid var(--border);
    padding:    clamp(3rem, 5vw, 5rem) 0 2rem;
  }

  .footer__inner {
    display:         flex;
    align-items:     flex-start;
    justify-content: space-between;
    gap:             2rem;
    flex-wrap:       wrap;
    padding-bottom:  3rem;
    border-bottom:   1px solid var(--border);
  }

  .footer__left {
    display:        flex;
    flex-direction: column;
    gap:            0.3rem;
  }

  .footer__name {
    font-family:    var(--font-display);
    font-size:      1.1rem;
    font-weight:    700;
    letter-spacing: -0.01em;
  }

  .footer__caption {
    font-size: 0.75rem;
    color:     var(--text-muted);
  }

  .footer__nav {
    display: flex;
    gap:     2rem;
  }

  .footer__nav a {
    font-size:      0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--text-muted);
    transition:     color 0.2s;
  }

  .footer__nav a:hover { color: var(--text); }

  .footer__social {
    display: flex;
    gap:     1.75rem;
  }

  .footer__social-link {
    font-size:  0.75rem;
    color:      var(--text-muted);
    transition: color 0.2s;
  }

  .footer__social-link:hover { color: var(--accent); }

  .footer__base {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    padding-top:     1.5rem;
    font-size:       0.72rem;
    color:           var(--text-muted);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ─────────────────────────────────────────────────────────────
  // PAGE INTRO — white screen → name flashes → slides up
  // ─────────────────────────────────────────────────────────────
  const intro     = document.getElementById('intro')!;
  const introName = intro.querySelector('.intro__name') as HTMLElement;

  gsap.timeline({
    onComplete: () => { intro.style.display = 'none'; },
  })
    .to(introName, { opacity: 1, duration: 0.4, ease: 'power2.out' })
    .to(introName, { opacity: 0, duration: 0.3, ease: 'power2.in' }, '+=0.2')
    .to(intro,     { yPercent: -100, duration: 0.75, ease: 'power3.inOut' }, '-=0.1');

  // ─────────────────────────────────────────────────────────────
  // TEXT SCRAMBLE ENGINE
  // Katakana + symbols = "alien language" feel
  // ─────────────────────────────────────────────────────────────
  const CHARS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンヴ#@$%&!?><|/~^*';

  class TextScramble {
    private el:      HTMLElement;
    private resolve: () => void = () => {};
    private raf:     number     = 0;
    private frame:   number     = 0;
    private queue:   { to: string; start: number; end: number; char: string }[] = [];

    constructor(el: HTMLElement) { this.el = el; }

    run(text: string): Promise<void> {
      const promise = new Promise<void>((res) => (this.resolve = res));
      this.queue = Array.from(text, (char, i) => ({
        to:    char,
        // i * 4 staggers each character — left-to-right decode feel
        start: Math.floor(i * 4),
        // Each char scrambles for 28-44 frames before locking in (~0.5-0.7s per char)
        end:   Math.floor(i * 4) + 28 + Math.floor(Math.random() * 16),
        char:  '',
      }));
      cancelAnimationFrame(this.raf);
      this.frame = 0;
      this.tick();
      return promise;
    }

    private tick() {
      let out      = '';
      let complete = 0;

      for (const item of this.queue) {
        if (this.frame >= item.end) {
          complete++;
          out += item.to === ' ' ? '&nbsp;' : item.to;
        } else if (this.frame >= item.start) {
          if (!item.char || Math.random() < 0.28) {
            item.char = CHARS[Math.floor(Math.random() * CHARS.length)];
          }
          out += `<span class="sc">${item.char}</span>`;
        } else {
          // waiting — invisible placeholder so layout stays locked
          out += `<span class="sc sc--dim" aria-hidden="true">_</span>`;
        }
      }

      this.el.innerHTML = out;

      if (complete < this.queue.length) {
        this.frame++;
        this.raf = requestAnimationFrame(() => this.tick());
      } else {
        // Restore clean text — no innerHTML artifacts left behind
        this.el.textContent = text;
        this.resolve();
      }
    }
  }

  // ─────────────────────────────────────────────────────────────
  // Apply scramble to h2, h3, h4, h5 and [data-scramble]
  //
  // FIX: use visibility:hidden (not textContent='') so elements
  // keep their dimensions — zero layout shift on trigger.
  // ─────────────────────────────────────────────────────────────
  // Exclude everything inside #services — the pin handles that section's
  // own reveal, and scramble's ScrollTrigger breaks inside a pinned element
  const scrambleTargets = document.querySelectorAll<HTMLElement>(
    'h2, h3, h4, h5, [data-scramble]'
  );

  scrambleTargets.forEach((el) => {
    const original = el.textContent?.trim() ?? '';
    if (!original) return;

    // Hide visually but keep layout space intact
    el.style.visibility = 'hidden';

    ScrollTrigger.create({
      trigger:  el,
      start:    'top 90%',
      once:     true,
      onEnter: () => {
        el.style.visibility = 'visible';
        new TextScramble(el).run(original);
      },
    });
  });

  // ─────────────────────────────────────────────────────────────
  // SERVICES — staggered scroll reveal
  // Each item fades + slides up as it enters the viewport and
  // stays visible — they stack up as you scroll down.
  // ─────────────────────────────────────────────────────────────
  gsap.utils.toArray<HTMLElement>('.services__item').forEach((item, i) => {
    gsap.to(item, {
      scrollTrigger: {
        trigger:       item,
        start:         'top 82%',
        toggleActions: 'play none none none',
      },
      opacity:  1,
      y:        0,
      duration: 0.75,
      delay:    i * 0.08,
      ease:     'power3.out',
    });
  });

  // ─────────────────────────────────────────────────────────────
  // Fade-up: generic scroll reveal
  // ─────────────────────────────────────────────────────────────
  gsap.utils.toArray<HTMLElement>('[data-fade-up]').forEach((el) => {
    gsap.from(el, {
      scrollTrigger: {
        trigger:       el,
        start:         'top 88%',
        toggleActions: 'play none none none',
      },
      opacity:  0,
      y:        40,
      duration: 0.85,
      ease:     'power3.out',
    });
  });

  // ─────────────────────────────────────────────────────────────
  // Skills pills — stagger scale in
  // ─────────────────────────────────────────────────────────────
  const skillsEl = document.querySelector('[data-stagger]');
  if (skillsEl) {
    gsap.to(skillsEl.querySelectorAll('.skills__pill'), {
      scrollTrigger: {
        trigger:       skillsEl,
        start:         'top 88%',
        toggleActions: 'play none none none',
      },
      opacity:  1,
      scale:    1,
      duration: 0.45,
      stagger:  0.04,
      ease:     'power2.out',
    });
  }

  // ─────────────────────────────────────────────────────────────
  // WORK — horizontal scroll + 3D tilt
  // ─────────────────────────────────────────────────────────────
  const track   = document.getElementById('work-track')   as HTMLElement;
  const hscroll = document.getElementById('work-hscroll') as HTMLElement;

  if (track && hscroll) {
    // Pin the strip, scrub the track left as you scroll down
    gsap.to(track, {
      x: () => -(track.scrollWidth - hscroll.clientWidth),
      ease: 'none',
      scrollTrigger: {
        trigger:           hscroll,
        start:             `top top+=${NAV_H}`,
        end:               () => `+=${track.scrollWidth - hscroll.clientWidth}`,
        pin:               true,
        anticipatePin:     1,
        scrub:             1,
        invalidateOnRefresh: true,
      },
    });

    // 3D tilt + shine per card
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      const shine = card.querySelector<HTMLElement>('.work__card-shine');

      card.addEventListener('mousemove', (e: MouseEvent) => {
        const r  = card.getBoundingClientRect();
        const nx = (e.clientX - r.left)  / r.width  - 0.5; // -0.5 → 0.5
        const ny = (e.clientY - r.top)   / r.height - 0.5;

        gsap.to(card, {
          rotateY:             nx * 14,
          rotateX:             -ny * 14,
          transformPerspective: 900,
          duration:            0.4,
          ease:                'power1.out',
        });

        // Shine tracks exact cursor position
        if (shine) {
          const mx = ((e.clientX - r.left)  / r.width)  * 100;
          const my = ((e.clientY - r.top)   / r.height) * 100;
          card.style.setProperty('--mx', `${mx}%`);
          card.style.setProperty('--my', `${my}%`);
        }
      });

      card.addEventListener('mouseleave', () => {
        gsap.to(card, {
          rotateY:             0,
          rotateX:             0,
          duration:            0.8,
          ease:                'elastic.out(1, 0.5)',
        });
      });
    });
  }

  // ─────────────────────────────────────────────────────────────
  // Magnetic buttons
  // ─────────────────────────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const r = el.getBoundingClientRect();
      const x = e.clientX - r.left - r.width  / 2;
      const y = e.clientY - r.top  - r.height / 2;
      gsap.to(el, { x: x * 0.3, y: y * 0.3, duration: 0.35, ease: 'power2.out' });
    });
    el.addEventListener('mouseleave', () => {
      gsap.to(el, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
    });
  });
</script>
