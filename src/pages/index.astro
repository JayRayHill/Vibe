---
import Layout    from '../layouts/Layout.astro';
import Cursor    from '../components/Cursor.astro';
import Nav       from '../components/Nav.astro';
import Hero      from '../components/Hero.astro';
import Work      from '../components/Work.astro';
import Services  from '../components/Services.astro';
import Skills    from '../components/Skills.astro';
import Statement from '../components/Statement.astro';
import Contact   from '../components/Contact.astro';
---

<Layout
  title="Jaron Hill — Web Developer & UX Designer"
  description="Portfolio of Jaron Hill — web developer and UX designer at Unique Supply, building systems that work and look beautiful."
>
  <Cursor />
  <Nav />

  <main id="main">
    <Hero />
    <Work />
    <Services />
    <Skills />
    <Statement />
    <Contact />
  </main>

  <footer class="footer">
    <div class="container footer__inner">

      <div class="footer__left">
        <span class="footer__name">Jaron Hill</span>
        <span class="footer__caption">Web Development &amp; UX Design</span>
      </div>

      <nav class="footer__nav" aria-label="Footer navigation">
        <a href="#work">Work</a>
        <a href="#services">Services</a>
        <a href="#about">About</a>
        <a href="#contact">Contact</a>
      </nav>

      <div class="footer__social">
        <a href="#" aria-label="LinkedIn"  class="footer__social-link">LinkedIn</a>
        <a href="#" aria-label="GitHub"    class="footer__social-link">GitHub</a>
        <a href="#" aria-label="Dribbble"  class="footer__social-link">Dribbble</a>
      </div>

    </div>
    <div class="container footer__base">
      <span>&copy; {new Date().getFullYear()} Jaron Hill. All rights reserved.</span>
      <span class="footer__credit">Built with Astro &amp; GSAP</span>
    </div>
  </footer>
</Layout>

<style>
  .footer {
    border-top: 1px solid var(--border);
    padding:    clamp(3rem, 5vw, 5rem) 0 2rem;
  }

  .footer__inner {
    display:         flex;
    align-items:     flex-start;
    justify-content: space-between;
    gap:             2rem;
    flex-wrap:       wrap;
    padding-bottom:  3rem;
    border-bottom:   1px solid var(--border);
  }

  .footer__left {
    display:        flex;
    flex-direction: column;
    gap:            0.3rem;
  }

  .footer__name {
    font-family:    var(--font-display);
    font-size:      1.1rem;
    font-weight:    700;
    letter-spacing: -0.01em;
  }

  .footer__caption {
    font-size: 0.75rem;
    color:     var(--text-muted);
  }

  .footer__nav {
    display: flex;
    gap:     2rem;
  }

  .footer__nav a {
    font-size:      0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color:          var(--text-muted);
    transition:     color 0.2s;
  }

  .footer__nav a:hover { color: var(--text); }

  .footer__social {
    display: flex;
    gap:     1.75rem;
  }

  .footer__social-link {
    font-size:  0.75rem;
    color:      var(--text-muted);
    transition: color 0.2s;
  }

  .footer__social-link:hover { color: var(--accent); }

  .footer__base {
    display:         flex;
    align-items:     center;
    justify-content: space-between;
    padding-top:     1.5rem;
    font-size:       0.72rem;
    color:           var(--text-muted);
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  // ── Fade-up: generic scroll reveal ──────────────────────────
  gsap.utils.toArray<HTMLElement>('[data-fade-up]').forEach((el) => {
    gsap.from(el, {
      scrollTrigger: {
        trigger:       el,
        start:         'top 88%',
        toggleActions: 'play none none none',
      },
      opacity:  0,
      y:        40,
      duration: 0.85,
      ease:     'power3.out',
    });
  });

  // ── Skills pills: stagger in ─────────────────────────────────
  const skillsEl = document.querySelector('[data-stagger]');
  if (skillsEl) {
    gsap.to(skillsEl.querySelectorAll('.skills__pill'), {
      scrollTrigger: {
        trigger:       skillsEl,
        start:         'top 88%',
        toggleActions: 'play none none none',
      },
      opacity:   1,
      scale:     1,
      duration:  0.45,
      stagger:   0.045,
      ease:      'power2.out',
    });
  }

  // ── Work cards: stagger up ───────────────────────────────────
  gsap.utils.toArray<HTMLElement>('.work__card').forEach((card, i) => {
    gsap.from(card, {
      scrollTrigger: {
        trigger:       card,
        start:         'top 92%',
        toggleActions: 'play none none none',
      },
      opacity:  0,
      y:        32,
      duration: 0.6,
      delay:    i * 0.07,
      ease:     'power2.out',
    });
  });

  // ── Services items: stagger ──────────────────────────────────
  gsap.utils.toArray<HTMLElement>('.services__item').forEach((item, i) => {
    gsap.from(item, {
      scrollTrigger: {
        trigger:       item,
        start:         'top 90%',
        toggleActions: 'play none none none',
      },
      opacity:  0,
      y:        24,
      duration: 0.65,
      delay:    i * 0.06,
      ease:     'power2.out',
    });
  });

  // ── Text Scramble Engine ─────────────────────────────────────
  // Charset: Katakana + symbols → looks like a nonexistent alien language
  const CHARS = 'アイウエオカキクケコサシスセソタチツテトナニヌネノハヒフヘホマミムメモヤユヨラリルレロワヲンヴ#@$%&!?><\\|/~^*';

  class TextScramble {
    private el:      HTMLElement;
    private resolve: () => void = () => {};
    private raf:     number     = 0;
    private frame:   number     = 0;
    private queue:   { to: string; start: number; end: number; char: string }[] = [];

    constructor(el: HTMLElement) { this.el = el; }

    run(text: string): Promise<void> {
      const len     = text.length;
      const promise = new Promise<void>((res) => (this.resolve = res));
      this.queue    = Array.from({ length: len }, (_, i) => ({
        to:    text[i],
        start: Math.floor(i * 1.2),                // stagger start per character
        end:   Math.floor(i * 1.2) + Math.floor(6 + Math.random() * 8),
        char:  '',
      }));
      cancelAnimationFrame(this.raf);
      this.frame = 0;
      this.tick();
      return promise;
    }

    private tick() {
      let out      = '';
      let complete = 0;

      for (const item of this.queue) {
        if (this.frame >= item.end) {
          complete++;
          out += item.to;
        } else if (this.frame >= item.start) {
          if (!item.char || Math.random() < 0.3) {
            item.char = CHARS[Math.floor(Math.random() * CHARS.length)];
          }
          out += `<span class="sc">${item.char}</span>`;
        } else {
          // not started yet — show a placeholder dim char
          out += `<span class="sc sc--dim">_</span>`;
        }
      }

      this.el.innerHTML = out;

      if (complete < this.queue.length) {
        this.frame++;
        this.raf = requestAnimationFrame(() => this.tick());
      } else {
        // Restore plain textContent so innerHTML stays clean
        this.el.textContent = this.el.textContent;
        this.resolve();
      }
    }
  }

  // ── Apply scramble on scroll enter ───────────────────────────
  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
    const original = el.textContent?.trim() ?? '';
    el.textContent = '';  // hide until triggered

    ScrollTrigger.create({
      trigger:  el,
      start:    'top 88%',
      once:     true,
      onEnter:  () => new TextScramble(el).run(original),
    });
  });

  // ── Magnetic buttons ─────────────────────────────────────────
  document.querySelectorAll<HTMLElement>('.magnetic').forEach((el) => {
    el.addEventListener('mousemove', (e: MouseEvent) => {
      const r = el.getBoundingClientRect();
      const x = e.clientX - r.left - r.width  / 2;
      const y = e.clientY - r.top  - r.height / 2;
      gsap.to(el, { x: x * 0.3, y: y * 0.3, duration: 0.35, ease: 'power2.out' });
    });
    el.addEventListener('mouseleave', () => {
      gsap.to(el, { x: 0, y: 0, duration: 0.6, ease: 'elastic.out(1, 0.5)' });
    });
  });
</script>
